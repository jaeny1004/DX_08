# 현장 모바일 앱 환경변수 예시.
# 실제 값은 .env.local 에 넣는다 (.gitignore 대상).

# --- Supabase ---
# 웹 관제 대시보드(DX_08)와 반드시 같은 프로젝트여야 한다.
# 앱이 pine_records / field_photos / field_voice_logs 에 쓰고
# 웹이 그것을 읽어 확진목 타임라인에 붙이기 때문이다.
#
# ANON_KEY 는 브라우저 노출을 전제로 한 publishable 키다. RLS 로 보호된다.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_YOUR_KEY"

# --- 웹 백엔드 (RAG 챗봇 + 음성 STT) ---
# 예전에는 Supabase Edge Function(chat-rag, field-audio-stt)을 썼지만
# 프로젝트를 옮길 때마다 조용히 망가져서 웹 백엔드로 합쳤다.
# 로컬 백엔드를 띄웠다면 8788, 아니면 배포 주소를 쓴다.
VITE_RAG_API_BASE="http://127.0.0.1:8788"
