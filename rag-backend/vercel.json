{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "excludeFiles": "{data/chroma/**,data/docs/**,data/generated_drafts/**,data/generated_reports/**,scripts/**,tests/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
